#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12

/* 速度倍率（例）:
 * いま 2/1 (=2倍) になっているなら、
 * 1.1倍にしたい場合は 11/10 にできます（小数は使わず分数で調整）
 * 例: <&zip_xy_scaler 11 10>
 */
&mmv_input_listener { input-processors = <&zip_xy_scaler 50 10>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 35 10>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    /* Encoder behaviors */
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <100>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        /* =========================
         * layer0 (Base)
         * ========================= */
        layer_0 {
            bindings = <
                &kp ESC         &kp N1   &kp N2   &kp N3   &kp N4   &kp N5      &kp N6   &kp N7   &kp N8   &kp N9   &kp N0     &kp BACKSPACE
                &kp TAB         &kp Q    &kp W    &kp E    &kp R    &kp T       &kp Y    &kp U    &kp I    &kp O    &kp P      &kp RBKT
                &kp LSHIFT      &kp A    &kp S    &kp D    &kp F    &kp G       &kp H    &kp J    &kp K    &kp L    &kp SEMI   &kp COLON
                &kp LCTRL       &kp Z    &kp X    &kp C    &kp V    &kp B       &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH   &kp MINUS

                                              &kp LALT   &kp SPACE  &mo 1      &mo 2     &kp ENTER
                                                        &mkp MB1   &mkp MB2   &mo 3
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        /* =========================
         * layer1
         * （表のとおり：home / win+r / win+d / ctrl+c / ctrl+v / BS など）
         * ※ PrintScreen は PSCRN
         * ========================= */
        layer_1 {
            bindings = <
                &kp EXCL        &kp AT     &kp HASH   &kp DLLR    &kp PRCNT  &kp CARET          &kp AMPS  &kp ASTERISK &kp LPAR   &kp RPAR   &kp MINUS  &kp BACKSPACE

                &kp TAB         &none      &kp LC(W)  &kp LG(E)   &kp LG(R)  &kp LC(T)          &kp LC(Y)  &kp END      &kp END    &kp LBKT   &kp RBKT   &kp INT_YEN
                &kp CAPS        &none      &kp PSCRN  &kp LG(D)   &kp LC(C)  &kp LC(X)          &kp DEL    &kp LC(V)    &kp DEL    &kp LG(L)  &none      &kp LS(BSLH)
                &kp LCTRL       &kp LC(Z)  &none      &kp LC(Z)   &kp LC(A)  &kp BACKSPACE      &kp LC(N)  &kp LC(V)    &kp COMMA  &kp DOT    &kp FSLH   &kp UNDERSCORE

                                              &kp LALT   &kp SPACE  &trans                      &mo 2     &kp ENTER
                                                         &mkp MB1   &mkp MB2                    &mo 3
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        /* =========================
         * layer2 (US記号 + Fキー / nav)
         * ========================= */
        layer_2 {
            bindings = <
                &kp ESC         &kp F1    &kp F2        &kp F3        &kp F4     &kp F5             &kp F6      &kp F7      &kp F8        &kp F9      &kp F10       &kp TILDE
                &kp TAB         &kp EXCL  &kp STAR      &kp HASH      &kp DLLR   &kp PRCNT          &kp SQT     &kp DQT     &kp PLUS      &kp MINUS   &kp QMARK     &kp PIPE
                &kp LSHIFT      &none     &kp LT        &kp LBKT      &kp LBRC   &kp LPAR           &kp RPAR    &kp RBRC    &kp RBKT      &kp GT      &kp EQUAL     &kp BACKSLASH
                &kp LCTRL       &kp LGUI  &kp CARET     &kp AMPS      &kp SEMI   &kp COLON          &kp FSLH    &kp AT      &kp COMMA     &kp DOT     &kp GRAVE     &kp UNDERSCORE

                                                      &kp LALT   &kp SPACE  &mo 1                     &trans    &kp ENTER
                                                                 &mkp MB1   &mkp MB2                  &mo 3
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        /* =========================
         * layer3 (M1..M10 + arrows + volume)
         * ========================= */
        layer_3 {
            bindings = <
                &kp ESC         &kp F11         &kp F12           &kp F13         &kp F14          &kp F15          &kp F16        &kp F17  &kp F18    &kp F19    &kp F20    &kp BACKSPACE
                &kp TAB         &bt BT_SEL 0    &bt BT_SEL 1      &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4     &none          &none    &kp UP     &none      &none      &kp C_VOL_UP
                &kp LSHIFT      &bootloader     &bootloader       &none           &none            &kp LC(LS(TAB))  &kp LC(TAB)    &kp LEFT &kp DOWN   &kp RIGHT  &none      &kp C_VOL_DN
                &kp LCTRL       &kp LGUI        &none             &none           &none            &kp HOME         &kp END        &none    &none      &none      &none      &kp RCTRL

                                              &kp LALT   &kp SPACE  &mo 1      &mo 2     &kp ENTER
                                                        &mkp MB1   &mkp MB2   &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };
    };
};
